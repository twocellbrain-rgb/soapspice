RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.soapspice\.com$ [NC]
RewriteRule ^ https://soapspice.com%{REQUEST_URI} [R=301,L]

DirectoryIndex index.html

# Every supported route is generated as a directory containing index.html.
# Unknown URLs must return a genuine 404, not an indexable copy of the homepage.
ErrorDocument 404 /404.html
